{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./config/*.local.yaml)",
      "Edit(./config/*.local.yaml)",
      "Read(./data/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)"
    ]
  }
}
